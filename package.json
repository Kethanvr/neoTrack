{
  "name": "neotrace-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @neotrace/web",
    "dev:web": "npm run dev --workspace @neotrace/web",
    "dev:extension": "npm run dev --workspace @neotrace/extension",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:seed": "npm run db:seed --workspace @neotrace/web",
    "db:reset": "npm run db:reset --workspace @neotrace/web"
  },
  "engines": {
    "node": ">=22"
  }
}

